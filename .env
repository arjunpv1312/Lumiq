# Lumiq - Local Development .env
# Generated automatically - customise as needed

FLASK_ENV=development
FLASK_DEBUG=True
FLASK_SECRET_KEY=dev_secret_key_not_for_production

WTF_CSRF_SSL_STRICT=False
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=3600

MAX_CONTENT_LENGTH=20971520
MAX_FILE_SIZE=52428800
MAX_PREDICTION_LENGTH=5000

# SQLite for local dev (no Postgres needed)
DATABASE_URL=sqlite:///./data/lumiq.db

# Redis (optional locally - rate limiter falls back to memory://)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_RESULT_EXPIRES=3600
CELERY_WORKER_CONCURRENCY=2

SOCKETIO_ASYNC_MODE=threading
SOCKETIO_MESSAGE_QUEUE=

# Rate limiting (memory:// works without Redis in dev)
RATELIMIT_STORAGE_URL=memory://
RATELIMIT_DEFAULT=200 per day, 50 per hour
RATELIMIT_UPLOAD=5 per minute
RATELIMIT_SAMPLE=10 per minute
RATELIMIT_PROCESS=10 per minute
RATELIMIT_PROGRESS=100 per minute
RATELIMIT_RESULTS=20 per minute
RATELIMIT_PREDICT=30 per minute
RATELIMIT_DOWNLOAD=20 per minute
RATELIMIT_CLEANUP=5 per hour

USE_S3=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=lumiq-storage
AWS_S3_REGION=us-east-1
AWS_S3_PRESIGNED_URL_EXPIRY=3600

LOG_LEVEL=INFO
LOG_FILE=./logs/lumiq.log
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - [%(funcName)s:%(lineno)d] - %(message)s

JOB_CLEANUP_AGE_HOURS=2
ENABLE_CORS=False
CORS_ORIGINS=*
TRUSTED_PROXIES=127.0.0.1
