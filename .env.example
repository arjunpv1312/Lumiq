# Lumiq Application Configuration
# Copy this file to .env and update values before deploying

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_ENV=production
FLASK_DEBUG=False
FLASK_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING_IN_PRODUCTION

# ── Session & Security ────────────────────────────────────────────────────────
WTF_CSRF_SSL_STRICT=True
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=3600

# ── File Upload ───────────────────────────────────────────────────────────────
MAX_CONTENT_LENGTH=20971520
MAX_FILE_SIZE=52428800
MAX_PREDICTION_LENGTH=5000

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://lumiq:lumiq_pass@localhost:5432/lumiq_db

# Connection Pool (tune for your server)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300
DB_POOL_TIMEOUT=30

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Celery Task Queue ─────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_RESULT_EXPIRES=3600
# Number of parallel pipeline workers (CPU-heavy; start low)
CELERY_WORKER_CONCURRENCY=2

# ── Flask-SocketIO ────────────────────────────────────────────────────────────
SOCKETIO_ASYNC_MODE=gevent
# Must match REDIS_URL so all Flask processes share the same socket namespace
SOCKETIO_MESSAGE_QUEUE=redis://localhost:6379/0

# ── Rate Limiting (backed by Redis in production) ─────────────────────────────
RATELIMIT_STORAGE_URL=redis://localhost:6379/2
RATELIMIT_DEFAULT=200 per day, 50 per hour
RATELIMIT_UPLOAD=5 per minute
RATELIMIT_SAMPLE=10 per minute
RATELIMIT_PROCESS=10 per minute
RATELIMIT_PROGRESS=100 per minute
RATELIMIT_RESULTS=20 per minute
RATELIMIT_PREDICT=30 per minute
RATELIMIT_DOWNLOAD=20 per minute
RATELIMIT_CLEANUP=5 per hour

# ── AWS S3 File Storage (optional) ───────────────────────────────────────────
# Set USE_S3=true to store uploads/outputs in S3 instead of local disk
USE_S3=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=lumiq-storage
AWS_S3_REGION=us-east-1
AWS_S3_PRESIGNED_URL_EXPIRY=3600

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=./logs/lumiq.log
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - [%(funcName)s:%(lineno)d] - %(message)s

# ── Processing ────────────────────────────────────────────────────────────────
JOB_CLEANUP_AGE_HOURS=2

# ── CORS ──────────────────────────────────────────────────────────────────────
ENABLE_CORS=False
CORS_ORIGINS=*
TRUSTED_PROXIES=127.0.0.1
